// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Subject {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   RadonUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  notes         Note[]
  studySessions StudySession[]

  @@index([userId])
}

model Note {
  id        String   @id @default(cuid())
  title     String
  content   String?
  fileName  String?
  fileUrl   String?
  fileType  String?

 extractedText    String?
  extractionStatus String @default("pending")
  extractionError  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   RadonUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([subjectId])
}

model StudySession {
  id        String    @id @default(cuid())
  startedAt DateTime
  endedAt   DateTime?
  duration  Int?
  pausedMs  Int       @default(0)
  createdAt DateTime  @default(now())

  userId String
  user   RadonUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  subjectId String?
  subject   Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  @@index([userId, startedAt])
  @@index([subjectId])
}

model Activity {
  id        String   @id @default(cuid())
  type      String
  noteId    String?
  subjectId String?
  label     String
  createdAt DateTime @default(now())

  userId String
  user   RadonUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
}

model Subscription {
  id String @id @default(cuid())

  userId String @unique
  user   RadonUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  provider String @default("bachs")

  providerCustomerId     String?
  providerSubscriptionId String? @unique

  plan   String @default("pro")
  status String

  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?

  cancelAtPeriodEnd Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

model UserSettings {
  userId             String   @id
  user               RadonUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  studyReminders     Boolean  @default(true)
  productUpdates     Boolean  @default(true)
  emailNotifications Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model WebhookEvent {
  id        String   @id @default(cuid())
  provider  String
  eventId   String
  eventType String
  processedAt DateTime?
  createdAt DateTime @default(now())

  @@unique([provider, eventId])
  @@index([provider, processedAt])
}

// ==========================================
// Radon Auth models
// ==========================================

model RadonUser {
  id            String   @id
  email         String?
  emailVerified Boolean
  metadata      Json
  createdAt     DateTime
  updatedAt     DateTime

  subjects       Subject[]
  notes          Note[]
  studySessions  StudySession[]
  activities     Activity[]
  subscription   Subscription?
  settings       UserSettings?

  @@index([email])
}

model RadonIdentity {
  id                String   @id
  userId            String
  provider          String
  providerAccountId String
  metadata          Json
  createdAt         DateTime

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model RadonOneTimeCode {
  id         String    @id
  identifier String
  codeHash   String
  purpose    String
  expiresAt  DateTime
  attempts   Int
  consumedAt DateTime?
  metadata   Json
  createdAt  DateTime

  @@index([identifier, purpose])
  @@index([expiresAt])
}

model RadonSession {
  id        String   @id
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  metadata  Json
  createdAt DateTime

  @@index([userId])
  @@index([expiresAt])
}

model RadonRefreshToken {
  id        String    @id
  userId    String
  tokenHash String    @unique
  familyId  String
  expiresAt DateTime
  usedAt    DateTime?
  revokedAt DateTime?
  device    Json
  metadata  Json
  createdAt DateTime

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
}

model RadonApiKey {
  id         String    @id
  userId     String?
  orgId      String?
  prefix     String
  keyHash    String    @unique
  name       String
  scopes     String[]
  expiresAt  DateTime?
  lastUsedAt DateTime?
  revokedAt  DateTime?
  metadata   Json
  createdAt  DateTime

  @@index([userId])
  @@index([orgId])
}

model RadonOrg {
  id        String   @id
  name      String
  slug      String   @unique
  metadata  Json
  createdAt DateTime
  updatedAt DateTime
}

model RadonOrgMembership {
  id        String   @id
  orgId     String
  userId    String
  role      String
  metadata  Json
  createdAt DateTime

  @@unique([orgId, userId])
  @@index([orgId])
  @@index([userId])
}

model RadonOrgInvite {
  id              String    @id
  orgId           String
  email           String
  role            String
  tokenHash       String    @unique
  invitedByUserId String?
  expiresAt       DateTime
  acceptedAt      DateTime?
  metadata        Json
  createdAt       DateTime

  @@index([orgId])
}
