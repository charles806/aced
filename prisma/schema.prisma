// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
  
}

model Subject {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   RadonUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  notes         Note[]
  studySessions StudySession[]

  @@index([userId])
}

model Note {
  id        String   @id @default(cuid())
  title     String
  content   String?
  fileName  String?
  fileUrl   String?
  fileType  String?

 extractedText    String?
  extractionStatus String @default("pending")
  extractionError  String?

  summary          String?
  summaryStatus    String   @default("none")
  summaryError     String?
  summaryUpdatedAt DateTime?
  summaryModel     String?
  summaryLength    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   RadonUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([subjectId])

  aiConversations AIConversation[]

  flashcardDecks FlashcardDeck[]
  quizzes Quiz[]
}

model FlashcardDeck {
  id String @id @default(cuid())
  title String
  difficulty String?
  sourceNoteId String?
  sourceNote Note? @relation(fields: [sourceNoteId], references: [id], onDelete: SetNull)
  idempotencyKey String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user RadonUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  cards Flashcard[]
  progress FlashcardProgress[]

  @@index([userId])
  @@index([sourceNoteId])
  @@unique([userId, idempotencyKey])
}

model Flashcard {
  id String @id @default(cuid())
  deckId String
  deck FlashcardDeck @relation(fields: [deckId], references: [id], onDelete: Cascade)
  front String
  back String
  position Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  progress FlashcardProgress[]

  @@index([deckId])
  @@index([deckId, position])
}

model FlashcardProgress {
  id String @id @default(cuid())
  userId String
  user RadonUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  deckId String
  deck FlashcardDeck @relation(fields: [deckId], references: [id], onDelete: Cascade)
  cardId String
  card Flashcard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  status String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, cardId])
  @@index([userId, deckId])
  @@index([cardId])
}

model Quiz {
  id String @id @default(cuid())
  title String
  sourceNoteId String?
  sourceNote Note? @relation(fields: [sourceNoteId], references: [id], onDelete: SetNull)
  timeLimit Int? // in minutes
  questionCount Int
  difficulty String
  idempotencyKey String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user RadonUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  questions QuizQuestion[]
  attempts QuizAttempt[]

  @@index([userId])
  @@index([sourceNoteId])
  @@unique([userId, idempotencyKey])
}

model QuizQuestion {
  id String @id @default(cuid())
  quizId String
  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)
  prompt String
  options String[] // JSON array of options
  correctIndex Int // 0-based index of correct answer
  explanation String?
  position Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  answers QuizAnswer[]

  @@index([quizId])
  @@index([quizId, position])
}

model QuizAttempt {
  id String @id @default(cuid())
  quizId String
  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)
  userId String
  user RadonUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  status String // "in_progress", "submitted", "expired"
  startedAt DateTime @default(now())
  submittedAt DateTime?
  deadline DateTime // server-authoritative deadline
  score Int?
  correctCount Int?
  incorrectCount Int?
  unansweredCount Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  answers QuizAnswer[]

  @@index([userId])
  @@index([quizId])
  @@index([userId, quizId])
  @@index([status])
}

model QuizAnswer {
  id String @id @default(cuid())
  attemptId String
  attempt QuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId String
  question QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedIndex Int? // null = unanswered
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([attemptId, questionId])
  @@index([attemptId])
  @@index([questionId])
}

model AIConversation {
  id        String   @id @default(cuid())
  userId    String
  user      RadonUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  noteId    String?
  note      Note?    @relation(fields: [noteId], references: [id], onDelete: SetNull)
  title     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages AIMessage[]

  @@index([userId])
  @@index([noteId])
  @@index([userId, updatedAt])
}

model AIMessage {
  id             String        @id @default(cuid())
  conversationId String
  conversation   AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String
  content        String
  createdAt      DateTime      @default(now())

  @@index([conversationId])
  @@index([createdAt])
}

model StudySession {
  id        String    @id @default(cuid())
  startedAt DateTime
  endedAt   DateTime?
  duration  Int?
  pausedMs  Int       @default(0)
  createdAt DateTime  @default(now())

  userId String
  user   RadonUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  subjectId String?
  subject   Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  @@index([userId, startedAt])
  @@index([subjectId])
}

model Activity {
  id        String   @id @default(cuid())
  type      String
  noteId    String?
  subjectId String?
  label     String
  createdAt DateTime @default(now())

  userId String
  user   RadonUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
}

model Subscription {
  id String @id @default(cuid())

  userId String @unique
  user   RadonUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  provider String @default("bachs")

  providerCustomerId     String?
  providerSubscriptionId String? @unique

  plan   String @default("pro")
  status String

  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?

  cancelAtPeriodEnd Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

model AnnualPurchase {
  id String @id @default(cuid())

  userId String
  user RadonUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  provider String @default("bachs")
  providerCheckoutId String? @unique
  providerPaymentId String? @unique

  plan String
  status String
  amountUsd String
  amountLocal String?
  currency String
  reference String?
  metadata Json?

  grantedAt DateTime?
  expiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([providerCheckoutId])
  @@index([status])
}

model UserSettings {
  userId             String   @id
  user               RadonUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  studyReminders     Boolean  @default(true)
  productUpdates     Boolean  @default(true)
  emailNotifications Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model WebhookEvent {
  id        String   @id @default(cuid())
  provider  String
  eventId   String
  eventType String
  processedAt DateTime?
  createdAt DateTime @default(now())

  @@unique([provider, eventId])
  @@index([provider, processedAt])
}

// ==========================================
// Radon Auth models
// ==========================================

model RadonUser {
  id            String   @id
  email         String?
  emailVerified Boolean
  metadata      Json
  createdAt     DateTime
  updatedAt     DateTime

  subjects       Subject[]
  notes          Note[]
  studySessions  StudySession[]
  activities     Activity[]
  subscription   Subscription?
  annualPurchases AnnualPurchase[]
  settings       UserSettings?
  aiConversations AIConversation[]
  flashcardDecks FlashcardDeck[]
  flashcardProgress FlashcardProgress[]
  quizzes Quiz[]
  quizAttempts QuizAttempt[]
  adminAuditLogs AdminAuditLog[]

  @@index([email])
}

model RadonIdentity {
  id                String   @id
  userId            String
  provider          String
  providerAccountId String
  metadata          Json
  createdAt         DateTime

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model RadonOneTimeCode {
  id         String    @id
  identifier String
  codeHash   String
  purpose    String
  expiresAt  DateTime
  attempts   Int
  consumedAt DateTime?
  metadata   Json
  createdAt  DateTime

  @@index([identifier, purpose])
  @@index([expiresAt])
}

model RadonSession {
  id        String   @id
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  metadata  Json
  createdAt DateTime

  @@index([userId])
  @@index([expiresAt])
}

model RadonRefreshToken {
  id        String    @id
  userId    String
  tokenHash String    @unique
  familyId  String
  expiresAt DateTime
  usedAt    DateTime?
  revokedAt DateTime?
  device    Json
  metadata  Json
  createdAt DateTime

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
}

model RadonApiKey {
  id         String    @id
  userId     String?
  orgId      String?
  prefix     String
  keyHash    String    @unique
  name       String
  scopes     String[]
  expiresAt  DateTime?
  lastUsedAt DateTime?
  revokedAt  DateTime?
  metadata   Json
  createdAt  DateTime

  @@index([userId])
  @@index([orgId])
}

model RadonOrg {
  id        String   @id
  name      String
  slug      String   @unique
  metadata  Json
  createdAt DateTime
  updatedAt DateTime
}

model RadonOrgMembership {
  id        String   @id
  orgId     String
  userId    String
  role      String
  metadata  Json
  createdAt DateTime

  @@unique([orgId, userId])
  @@index([orgId])
  @@index([userId])
}

model RadonOrgInvite {
  id              String    @id
  orgId           String
  email           String
  role            String
  tokenHash       String    @unique
  invitedByUserId String?
  expiresAt       DateTime
  acceptedAt      DateTime?
  metadata        Json
  createdAt       DateTime

  @@index([orgId])
}

model AdminAuditLog {
  id           String   @id @default(cuid())
  adminUserId  String
  action       String
  targetType   String
  targetId     String?
  metadata     Json?
  createdAt    DateTime @default(now())

  adminUser RadonUser @relation(fields: [adminUserId], references: [id], onDelete: Restrict)

  @@index([adminUserId, createdAt])
  @@index([action])
  @@index([targetType, targetId])
}
